# Copy this file to .env.local and fill in the values. Never commit real values.

# Database (Neon pooled connection string, ends with ?sslmode=require)
DATABASE_URL=

# Gemini (the only AI the app uses). Model default: gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Search providers, tried in this order. Any provider with a missing key is skipped.
TAVILY_API_KEY=
EXA_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
SERPER_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Protects the scheduled digest endpoint and the backfill endpoint
CRON_SECRET=

# Public address of the deployed site (used for links in emails), for example https://your-app.vercel.app
APP_URL=
